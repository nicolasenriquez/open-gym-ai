# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env
.env.*
*.env
!.env.example
!.env.*.example
!*.env.example
!backend/empty.env

# Refreshable provider credentials are separate from application backups.
/coach-auth/

# Host Python environments and caches are not project source.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
!.agents/
.agents/*
!.agents/README.md
!.agents/docs/
!.agents/docs/**
!.agents/skills/
!.agents/skills/**
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Local Windows junction to the shared verification skill (keep one tracked source).
.codex/skills/verify-opengym/

# Disposable Docker verification scripts and evidence
.scratch/docker-layout/
.scratch/platform-browser/
