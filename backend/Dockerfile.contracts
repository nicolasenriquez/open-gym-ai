FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
WORKDIR /app/api
RUN chown node:node /app/api
USER node
COPY --chown=node:node api/package.json api/package-lock.json ./
RUN npm ci --ignore-scripts --omit=optional --engine-strict --no-audit --no-fund && test "$(node --version)" = v22.23.2 && test "$(npm --version)" = 10.9.8
COPY --chown=node:node api/*.js ./
COPY --chown=node:node api/coach/ ./coach/
COPY --chown=node:node backend/contracts-run.mjs backend/versions.json LICENSE /app/
WORKDIR /app
ENV HOME=/tmp NODE_ENV=test
ENTRYPOINT ["node", "contracts-run.mjs"]
CMD ["environment"]
