FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node
RUN corepack enable && corepack prepare pnpm@10.34.8 --activate
WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,id=opengym-platform-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts --package-import-method=copy
COPY shared/ /app/shared/
COPY frontend/index.html frontend/vite.config.js ./
COPY frontend/src/ ./src/
COPY frontend/scripts/ ./scripts/
COPY frontend/public/ ./public/
RUN VITE_API_PREFIX=/api/v1 APP_BUILD=platform-browser-proof pnpm run build

FROM node AS browser-deps
WORKDIR /proof
COPY frontend/e2e/platform/package.json frontend/e2e/platform/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /proof
COPY --from=browser-deps /proof/ ./
COPY --from=node /app/frontend/dist/ ./public/
COPY frontend/e2e/platform/*.mjs ./
USER 1000:1000
ENV HOME=/tmp
ENTRYPOINT ["/usr/local/bin/node", "training.mjs"]
