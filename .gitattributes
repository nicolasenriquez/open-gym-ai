# Keep scripts and container files LF in the working tree too.
# core.autocrlf=true (the Windows default) rewrites them to CRLF on checkout, which breaks
# a `#!/bin/sh` shebang inside a Linux image: the kernel looks for "/bin/sh\r" and the
# container exits 127 before nginx starts (`web/05-check-base-path.sh`).
* text=auto
*.sh            text eol=lf
frontend/scripts/check-mobile-bundle.mjs text eol=lf
api/nudge-copy.js text eol=lf
api/coach/prompts/*.md text eol=lf
api/coach/core/library-data.js text eol=lf
api/coach/core/prompts.js text eol=lf
*.template      text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
docker-compose*.yml text eol=lf

# Documentary evidence hashes include line endings. Keep protected bodies stable
# across Windows/Linux checkouts; these files already use LF.
docs/dev/personal-recovery-discovery.md text eol=lf
docs/research/*.md text eol=lf
scripts/docs/*.mjs text eol=lf

# The Node Foundation inventory verifies this lock's SHA-256 inside Docker.
api/foundation/pnpm-lock.yaml text eol=lf
