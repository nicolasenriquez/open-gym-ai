{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "objectWrap": "collapse",
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/build/**",
    ".scratch/**",
    ".playwright-cli/**",
    ".agents/**",
    ".git/**",
    "docs/**",
    "openspec/**",
    "catalogue/**",
    "website/**",
    "frontend/android/**",
    "frontend/ios/**",
    "frontend/src/exercise-names/**",
    "frontend/src/exercise-desc/**",
    "frontend/src/instr/**",
    "frontend/src/lib/catalogue-langs.js",
    "frontend/src/lib/exercises-data.js",
    "frontend/src/lib/exercise-muscle-map.json",
    "frontend/src/lib/hevy-id-map.js",
    "frontend/src/lib/body-paths.js",
    "shared/coach-core/library-data.js",
    "shared/coach-core/prompts.js",
    "backend/src/opengym_platform/coach/assets.json",
    "backend/src/opengym_platform/notifications/copy.json",
    "**/*.md",
    "**/*.mdx",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/uv.lock"
  ]
}
